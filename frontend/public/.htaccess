# Server rules for the website and the app. They are deployed with the frontend (the demo's deploy writes its own file).

<IfModule mod_setenvif.c>
  # app. serves the same pages as the main address: keep it out of search results (the pages name the main address as theirs)
  SetEnvIfNoCase Host "^app\." LEOCAP_APP_HOST=1
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex" env=LEOCAP_APP_HOST
  # the page itself is always checked with the server first, so a visitor never keeps an old copy that points at deleted files
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www. -> the main address
  RewriteCond %{HTTP_HOST} ^www\.leocapinvest\.co\.ke$ [NC]
  RewriteRule ^ https://leocapinvest.co.ke%{REQUEST_URI} [R=301,L]

  # a file that does not exist under /assets is a real 404, never the app (an old tab asking for a file the last deploy removed)
  RewriteRule ^assets/ - [L]

  RewriteRule ^index\.html$ - [L]

  # /faq/ and /faq are one address
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /faq is answered by faq.html and /login/applicant by login-applicant.html: the same app, with that page's own title and
  # preview tags in the raw HTML (vite-seo.ts writes these files). Without such a file the address falls through to the app.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)$ /$1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1-$2.html -f
  RewriteRule ^([^/]+)/([^/]+)$ /$1-$2.html [L]

  # every other address belongs to the app (it shows its own "not found" page)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
